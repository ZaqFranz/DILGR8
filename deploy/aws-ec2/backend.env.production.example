NODE_ENV=production
PORT=4000

# Local MySQL on the same EC2 instance - dedicated app user, not root.
# Create this user yourself during setup (see README.md step 4); never
# reuse the MySQL root account for the application.
DATABASE_URL="mysql://dilgr8rsp_app:REPLACE_WITH_A_STRONG_PASSWORD@localhost:3306/dilgr8rsp"

# Generate your own - never reuse the local dev secret.
#   openssl rand -hex 48
JWT_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_48"
JWT_EXPIRES_IN="8h"

# Nginx serves the frontend and proxies /api on the same origin (see
# nginx.conf), so browser requests never leave the EC2 instance's own
# host/IP and CORS doesn't come into play for that path. Still set this to
# your instance's public IP or domain (http://, not https, unless you've
# set up TLS) as a safety net for any direct API access during testing.
CORS_ORIGIN="http://REPLACE_WITH_YOUR_EC2_PUBLIC_IP_OR_DOMAIN"

UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# Optional. Leave unset to log applicant emails to the console instead of
# sending them (see backend/.env.example) - fine for a first free-tier test.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="change-me"
# SMTP_SECURE=false
# SMTP_FROM="DILGR8RSP <no-reply@dilg.gov.ph>"
