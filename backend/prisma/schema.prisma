// DILGR8RSP database schema
// Covers the Application phase of the RSP pipeline (applicant registration,
// job postings, applications). See docs/database.md for the rationale and
// docs/rsp-domain-spec.md for the full target domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  APPLICANT
  ADMIN
  PANEL
}

enum PositionLevel {
  ENTRY
  PROMOTIONAL
}

enum EligibilityType {
  RA1080
  CSC_PROFESSIONAL
  CSC_SUBPROFESSIONAL
  BARANGAY
  NONE
}

enum DocumentType {
  ELIGIBILITY_PROOF
  IPCR
  DESIGNATION_ORDER
  OTHER
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_SIFTING
  FOR_INTERVIEW
  QUALIFIED
  NOT_QUALIFIED
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(APPLICANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicant        Applicant?
  jobPostingsMade  JobPosting[]
  evaluationsMade  Application[]
  auditLogEntries  AuditLog[]
  panelAssignments PanelAssignment[]
  panelEvaluations PanelEvaluation[]

  @@map("users")
}

/// Demographic profile + reusable applicant record. Created once per user;
/// referenced by every Application the user submits.
model Applicant {
  id     String @id @default(uuid())
  userId String @unique

  firstName     String
  middleName    String?
  lastName      String
  suffix        String?
  dateOfBirth   DateTime
  sex           String
  civilStatus   String
  address       String
  contactNumber String

  // Eligibility (Y/N). If Y, eligibilityType records the checklist item
  // chosen (RA1080 / CSC Professional / CSC Sub-Professional / Barangay)
  // and proof must be uploaded as a Document(type=ELIGIBILITY_PROOF).
  // If N, eligibilityValidated stays false and the record is flagged for
  // manual admin validation (surfaced in the UI in red).
  hasEligibility       Boolean         @default(false)
  eligibilityType      EligibilityType @default(NONE)
  eligibilityValidated Boolean         @default(false)

  // Set once the applicant finishes every step of the registration flow
  // (profile, work experience, L&D, awards, documents). Null means the
  // applicant is mid-registration; gates access to the rest of the app so
  // no applicant data collection is deferred to after login.
  registrationCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]
  ldInterventions LdIntervention[]
  awards          Award[]
  documents       Document[]
  applications    Application[]

  @@map("applicants")
}

model WorkExperience {
  id                  String    @id @default(uuid())
  applicantId         String
  inclusiveFrom       DateTime
  inclusiveTo         DateTime?
  positionDesignation String
  agency              String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("work_experiences")
}

model LdIntervention {
  id               String   @id @default(uuid())
  applicantId      String
  title            String
  dateAttended     DateTime
  numberOfHours    Int
  sponsoringAgency String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("ld_interventions")
}

model Award {
  id          String   @id @default(uuid())
  applicantId String
  title       String
  dateAwarded DateTime
  issuingBody String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("awards")
}

/// Uploaded proof documents. Eligibility proof is applicant-level
/// (applicationId null); IPCR / Designation-to-Higher-Position uploads are
/// tied to the specific promotional Application they support.
model Document {
  id            String       @id @default(uuid())
  applicantId   String
  applicationId String?
  type          DocumentType
  fileName      String
  filePath      String
  mimeType      String
  fileSizeBytes Int
  uploadedAt    DateTime     @default(now())

  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([applicationId])
  @@map("documents")
}

/// A vacancy applicants can apply to. closingAt is computed server-side at
/// creation time as postedAt + 10 days, 23:59:59 (see JobPostingsService).
model JobPosting {
  id            String            @id @default(uuid())
  title         String
  positionLevel PositionLevel
  qualificationEducation   String @db.Text
  qualificationTraining    String @db.Text
  qualificationExperience  String @db.Text
  qualificationEligibility String @db.Text
  postedAt      DateTime          @default(now())
  closingAt     DateTime
  status        JobPostingStatus  @default(OPEN)
  // Nullable + SetNull (not the required/Restrict Prisma would otherwise
  // default to) so deleting the admin who posted a job doesn't get
  // blocked by, or cascade into deleting, the postings they made.
  createdByUserId String?

  createdBy        User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  applications     Application[]
  panelAssignments PanelAssignment[]

  @@index([status])
  @@map("job_postings")
}

/// One applicant's application to one job posting. Unique per
/// (applicantId, jobPostingId) - an applicant may apply to several
/// postings but only once each.
model Application {
  id           String            @id @default(uuid())
  applicantId  String
  jobPostingId String
  status       ApplicationStatus @default(SUBMITTED)
  submittedAt  DateTime          @default(now())

  // Set together by ApplicationsService.evaluate() (admin-only). Score is
  // bounded 0-100 at the DTO validation layer, not the DB, so the
  // allowable-threshold check stays visible in one place (see api.md).
  evaluationScore   Int?
  evaluationRemarks String?   @db.Text
  evaluatedAt       DateTime?
  evaluatedByUserId String?

  applicant        Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobPosting       JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  evaluatedBy      User?             @relation(fields: [evaluatedByUserId], references: [id])
  documents        Document[]
  panelEvaluations PanelEvaluation[]

  @@unique([applicantId, jobPostingId])
  @@index([jobPostingId])
  @@map("applications")
}

/// Admin-managed interview rubric (spec: "Administrator can edit/update
/// evaluation forms"). maxScore doubles as the criterion's weight - a
/// panelist's total for one application is the sum of their per-criterion
/// scores. isActive lets a criterion be retired without breaking historical
/// PanelScore rows (see the delete guard in EvaluationCriteriaService).
model EvaluationCriterion {
  id        String   @id @default(uuid())
  name      String
  maxScore  Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores PanelScore[]

  @@map("evaluation_criteria")
}

/// Which PANEL users sit on which job posting's interview board. Pure
/// assignment metadata - deleting the posting or the panel user just drops
/// the assignment, not blocked (unlike the audit-relevant rows below).
model PanelAssignment {
  id           String   @id @default(uuid())
  jobPostingId String
  panelUserId  String
  assignedAt   DateTime @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  panelUser  User       @relation(fields: [panelUserId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, panelUserId])
  @@map("panel_assignments")
}

/// One panelist's evaluation of one application - header row (remarks +
/// timestamps); per-criterion scores live in PanelScore. Upserted by
/// PanelEvaluationsService.submit() the same way ApplicationsService.evaluate()
/// overwrites a prior single-admin evaluation.
model PanelEvaluation {
  id            String   @id @default(uuid())
  applicationId String
  panelUserId   String
  remarks       String?  @db.Text
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  panelUser   User         @relation(fields: [panelUserId], references: [id], onDelete: Cascade)
  scores      PanelScore[]

  @@unique([applicationId, panelUserId])
  @@map("panel_evaluations")
}

/// One criterion's score within a PanelEvaluation. criterionId has no
/// onDelete override (defaults to Restrict) - EvaluationCriteriaService
/// blocks deleting a criterion that already has scores, directing the admin
/// to deactivate it instead (see EvaluationCriterion.isActive).
model PanelScore {
  id                String @id @default(uuid())
  panelEvaluationId String
  criterionId       String
  score             Int

  panelEvaluation PanelEvaluation     @relation(fields: [panelEvaluationId], references: [id], onDelete: Cascade)
  criterion       EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([panelEvaluationId, criterionId])
  @@map("panel_scores")
}

/// Append-only record of admin write actions (user/job-posting CRUD,
/// application evaluation). Deliberately has no update/delete path through
/// the API - see docs/decisions.md for why an audit trail must stay
/// write-once from the app's perspective.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
