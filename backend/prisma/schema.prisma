// DILGR8RSP database schema
// Covers the Application phase of the RSP pipeline (applicant registration,
// job postings, applications). See docs/database.md for the rationale and
// docs/rsp-domain-spec.md for the full target domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  APPLICANT
  ADMIN
  PANEL
}

enum EligibilityType {
  RA1080
  CSC_PROFESSIONAL
  CSC_SUBPROFESSIONAL
  BARANGAY
  NONE
}

// Order mirrors the official application-documents checklist (a-j):
// letter, PDS, performance rating, eligibility proof, L&D proof,
// transcript, diploma, PQE notice, designation proof, award proof.
enum DocumentType {
  APPLICATION_LETTER
  PDS
  PDS_EXCEL
  IPCR
  ELIGIBILITY_PROOF
  LD_PROOF
  TRANSCRIPT_OF_RECORDS
  DIPLOMA
  PQE_NOTICE
  DESIGNATION_ORDER
  AWARD_PROOF
  OTHER
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_SIFTING
  FOR_INTERVIEW
  QUALIFIED
  NOT_QUALIFIED
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(APPLICANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicant        Applicant?
  jobPostingsMade  JobPosting[]
  siftingsMade     Application[]
  auditLogEntries  AuditLog[]
  panelAssignments PanelAssignment[]
  panelEvaluations PanelEvaluation[]

  @@map("users")
}

/// Demographic profile + reusable applicant record. Created once per user;
/// referenced by every Application the user submits.
model Applicant {
  id     String @id @default(uuid())
  userId String @unique

  firstName     String
  middleName    String?
  lastName      String
  suffix        String?
  dateOfBirth   DateTime
  sex           String
  civilStatus   String
  address       String
  contactNumber String

  // Eligibility (Y/N). If Y, eligibilityType records the checklist item
  // chosen (RA1080 / CSC Professional / CSC Sub-Professional / Barangay)
  // and proof must be uploaded as a Document(type=ELIGIBILITY_PROOF).
  // If N, eligibilityValidated stays false and the record is flagged for
  // manual admin validation (surfaced in the UI in red).
  hasEligibility       Boolean         @default(false)
  eligibilityType      EligibilityType @default(NONE)
  eligibilityValidated Boolean         @default(false)

  // Set once the applicant finishes every step of the registration flow
  // (profile, work experience, L&D, awards, documents). Null means the
  // applicant is mid-registration; gates access to the rest of the app so
  // no applicant data collection is deferred to after login.
  registrationCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]
  ldInterventions LdIntervention[]
  awards          Award[]
  documents       Document[]
  applications    Application[]

  @@map("applicants")
}

model WorkExperience {
  id                  String    @id @default(uuid())
  applicantId         String
  inclusiveFrom       DateTime
  inclusiveTo         DateTime?
  positionDesignation String
  agency              String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("work_experiences")
}

model LdIntervention {
  id               String   @id @default(uuid())
  applicantId      String
  title            String
  dateAttended     DateTime
  numberOfHours    Int
  sponsoringAgency String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applicant Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([applicantId])
  @@map("ld_interventions")
}

model Award {
  id          String   @id @default(uuid())
  applicantId String
  title       String
  dateAwarded DateTime
  issuingBody String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicant Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([applicantId])
  @@map("awards")
}

/// Uploaded proof documents. Every applicant-level document type
/// (APPLICATION_LETTER, PDS, IPCR, ELIGIBILITY_PROOF, TRANSCRIPT_OF_RECORDS,
/// DIPLOMA, PQE_NOTICE, DESIGNATION_ORDER, OTHER) is uploaded against the
/// applicant during registration (applicationId null) - none of them are
/// gated to, or require, a specific Application. LD_PROOF and AWARD_PROOF
/// are the exceptions, each tied to the specific LdIntervention/Award entry
/// it backs up - required per entry (see ApplicantsService.completeRegistration()),
/// same as Eligibility Proof is required when hasEligibility is declared.
model Document {
  id               String          @id @default(uuid())
  applicantId      String
  applicationId    String?
  ldInterventionId String?
  awardId          String?
  type             DocumentType
  fileName         String
  filePath         String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime        @default(now())

  applicant      Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ldIntervention LdIntervention? @relation(fields: [ldInterventionId], references: [id], onDelete: Cascade)
  award          Award?          @relation(fields: [awardId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([applicationId])
  @@index([ldInterventionId])
  @@index([awardId])
  @@map("documents")
}

/// A vacancy applicants can apply to. closingAt is computed server-side at
/// creation time as postedAt + 10 days, 23:59:59 (see JobPostingsService).
model JobPosting {
  id                       String @id @default(uuid())
  title                    String
  description              String @db.Text
  numberOfVacantPositions  String
  plantillaNumbers         String @db.Text
  salaryGrade              String
  monthlySalary            String
  placeOfAssignment        String @db.Text
  positionNextInRank       String @db.Text
  qualificationEducation   String @db.Text
  qualificationTraining    String @db.Text
  qualificationExperience  String @db.Text
  qualificationEligibility String @db.Text
  // Free text, one duty per line - rendered as a numbered list on the
  // applicant-facing details view.
  duties        String            @db.Text
  postedAt      DateTime          @default(now())
  closingAt     DateTime
  status        JobPostingStatus  @default(OPEN)
  // Nullable + SetNull (not the required/Restrict Prisma would otherwise
  // default to) so deleting the admin who posted a job doesn't get
  // blocked by, or cascade into deleting, the postings they made.
  createdByUserId String?

  createdBy             User?                            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  applications          Application[]
  panelAssignments      PanelAssignment[]
  requiredEligibilities JobPostingRequiredEligibility[]

  @@index([status])
  @@map("job_postings")
}

/// One required eligibility type for a posting (e.g. a posting requiring
/// either RA1080 or CSC Professional has two rows). Empty for a posting -
/// no row at all - means no eligibility is required to apply. A join table
/// rather than a Prisma scalar list because MySQL doesn't support those.
model JobPostingRequiredEligibility {
  id              String          @id @default(uuid())
  jobPostingId    String
  eligibilityType EligibilityType

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, eligibilityType])
  @@map("job_posting_required_eligibilities")
}

/// One applicant's application to one job posting. Unique per
/// (applicantId, jobPostingId) - an applicant may apply to several
/// postings but only once each.
model Application {
  id           String            @id @default(uuid())
  applicantId  String
  jobPostingId String
  status       ApplicationStatus @default(SUBMITTED)
  submittedAt  DateTime          @default(now())

  // Set together by ApplicationsService.sift() (admin-only) - the Sifting
  // phase's pass/fail call against the posting's qualification standards
  // (education/training/experience/eligibility). See docs/rsp-domain-spec.md.
  siftingRemarks String?   @db.Text
  siftedAt       DateTime?
  siftedByUserId String?

  // Set by ApplicationsService.importExaminationScores() (admin-only) - the
  // Pre-Qualifying Examination is conducted outside the system; the score is
  // imported via an Excel upload matched to the applicant by name.
  examinationScore    Int?
  examinationScoredAt DateTime?

  // Set together by ApplicationsService.scheduleInterview() (admin-only).
  // interviewVenue is required once scheduled (a date with no place isn't
  // useful); attire/notes are optional free text for anything else the
  // applicant needs to know ("what to wear", parking, documents to bring).
  interviewScheduledAt DateTime?
  interviewVenue       String?   @db.Text
  interviewAttire      String?   @db.Text
  interviewNotes       String?   @db.Text

  // Set by ApplicationsService.withdraw() - applicant-initiated, on their own
  // application only (no admin equivalent, so unlike siftedByUserId there's
  // no separate actor column: applicantId already identifies who withdrew).
  withdrawnAt DateTime?

  applicant        Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobPosting       JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  siftedBy         User?             @relation(fields: [siftedByUserId], references: [id])
  documents        Document[]
  panelEvaluations PanelEvaluation[]

  @@unique([applicantId, jobPostingId])
  @@index([jobPostingId])
  @@map("applications")
}

/// Admin-managed interview rubric (spec: "Administrator can edit/update
/// evaluation forms"). maxScore doubles as the criterion's weight - a
/// panelist's total for one application is the sum of their per-criterion
/// scores. isActive lets a criterion be retired without breaking historical
/// PanelScore rows (see the delete guard in EvaluationCriteriaService).
model EvaluationCriterion {
  id        String   @id @default(uuid())
  name      String
  maxScore  Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores PanelScore[]

  @@map("evaluation_criteria")
}

/// Which PANEL users sit on which job posting's interview board. Pure
/// assignment metadata - deleting the posting or the panel user just drops
/// the assignment, not blocked (unlike the audit-relevant rows below).
model PanelAssignment {
  id           String   @id @default(uuid())
  jobPostingId String
  panelUserId  String
  assignedAt   DateTime @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  panelUser  User       @relation(fields: [panelUserId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, panelUserId])
  @@map("panel_assignments")
}

/// One panelist's evaluation of one application - header row (remarks +
/// timestamps); per-criterion scores live in PanelScore. Upserted by
/// PanelEvaluationsService.submit() the same way ApplicationsService.evaluate()
/// overwrites a prior single-admin evaluation.
model PanelEvaluation {
  id            String   @id @default(uuid())
  applicationId String
  panelUserId   String
  remarks       String?  @db.Text
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  panelUser   User         @relation(fields: [panelUserId], references: [id], onDelete: Cascade)
  scores      PanelScore[]

  @@unique([applicationId, panelUserId])
  @@map("panel_evaluations")
}

/// One criterion's score within a PanelEvaluation. criterionId has no
/// onDelete override (defaults to Restrict) - EvaluationCriteriaService
/// blocks deleting a criterion that already has scores, directing the admin
/// to deactivate it instead (see EvaluationCriterion.isActive).
model PanelScore {
  id                String @id @default(uuid())
  panelEvaluationId String
  criterionId       String
  score             Int

  panelEvaluation PanelEvaluation     @relation(fields: [panelEvaluationId], references: [id], onDelete: Cascade)
  criterion       EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([panelEvaluationId, criterionId])
  @@map("panel_scores")
}

/// Append-only record of admin write actions (user/job-posting CRUD,
/// application evaluation). Deliberately has no update/delete path through
/// the API - see docs/decisions.md for why an audit trail must stay
/// write-once from the app's perspective.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
