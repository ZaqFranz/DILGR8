// DILGR8RSP database schema
// Covers the Application phase of the RSP pipeline (applicant registration,
// job postings, applications). See docs/database.md for the rationale and
// docs/rsp-domain-spec.md for the full target domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  APPLICANT
  ADMIN
  PANEL
}

enum EligibilityType {
  RA1080
  CSC_PROFESSIONAL
  CSC_SUBPROFESSIONAL
  BARANGAY
  NONE
}

// Ordered ascending (lowest to highest attainment) - the order itself is
// meaningful, not just a fixed vocabulary: JobPosting.minEducationLevel is
// compared against Applicant.educationLevel by ordinal position (see
// shared/constants/educationLevels.ts on both backend and frontend) to
// compute an automatic Sifting hint. The free-text qualificationEducation
// field stays the authoritative wording (e.g. "relevant to the job" can't
// be captured by an enum) - this only drives the hint, same soft-check
// pattern EligibilityType already uses via JobPostingRequiredEligibility.
enum EducationLevel {
  ELEMENTARY
  HIGH_SCHOOL
  VOCATIONAL
  COLLEGE_LEVEL
  BACHELORS
  MASTERS_LEVEL
  MASTERS
  DOCTORATE_LEVEL
  DOCTORATE
}

// Order mirrors the official application-documents checklist (a-j):
// letter, PDS, performance rating, eligibility proof, L&D proof,
// transcript, diploma, PQE notice, designation proof, award proof.
// COMPLIANCE_PROOF isn't part of that original checklist - it's uploaded
// later, per ApplicationComplianceItem, during the post-evaluation
// Compliance to Requirements phase (see docs/rsp-domain-spec.md §6).
enum DocumentType {
  APPLICATION_LETTER
  PDS
  PDS_EXCEL
  IPCR
  ELIGIBILITY_PROOF
  LD_PROOF
  TRANSCRIPT_OF_RECORDS
  DIPLOMA
  PQE_NOTICE
  DESIGNATION_ORDER
  AWARD_PROOF
  COMPLIANCE_PROOF
  OTHER
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

// FOR_INTERVIEW -> FOR_COMPLIANCE -> FOR_OATH_TAKING -> HIRED is the
// post-evaluation tail of the pipeline (docs/rsp-domain-spec.md §6-7).
// There's no separate "Deliberation" status - the RD's decision to advance
// an applicant is the same kind of single admin judgment-call action as
// sift()/scheduleInterview() already are, not a distinct system state.
enum ApplicationStatus {
  SUBMITTED
  UNDER_SIFTING
  FOR_INTERVIEW
  QUALIFIED
  NOT_QUALIFIED
  FOR_COMPLIANCE
  // Terminal "regret" outcomes past Sifting - NOT_QUALIFIED only ever
  // happens at Sifting (see sift()), so an applicant who doesn't advance
  // after the panel evaluation or after Compliance needs its own status:
  // otherwise the stage tracker (ApplicationStageTracker.tsx) would show
  // them as rejected back at the Sifting node, which would be wrong. Both
  // are set via ApplicationsService.rejectAfterInterview()/
  // rejectAfterCompliance() and send the same regretEmail() as NOT_QUALIFIED.
  NOT_SELECTED
  DISQUALIFIED
  FOR_OATH_TAKING
  HIRED
  WITHDRAWN
}

// PENDING until the applicant has uploaded a COMPLIANCE_PROOF document AND
// an admin has reviewed it - VERIFIED/REJECTED are both terminal per item
// (an admin can flip a REJECTED item to VERIFIED after the applicant
// re-uploads, but there's no separate "resubmitted" state - see
// ApplicationsService.reviewComplianceItem()).
enum ComplianceItemStatus {
  PENDING
  VERIFIED
  REJECTED
}

// How a requirement is expected to reach the admin for this one applicant -
// SOFTCOPY (default) means through the existing online
// Document(type=COMPLIANCE_PROOF) upload, and reviewComplianceItem() blocks
// VERIFIED until one exists; HARDCOPY means the applicant hands over a
// physical copy outside the system (e.g. an original ID shown in person),
// so there's nothing to upload and an admin can VERIFIED it directly on
// their own in-person review; BOTH requires both - the online upload gates
// VERIFIED exactly like SOFTCOPY, and the admin's own VERIFIED action is
// still what records that the physical copy was also received, same as
// HARDCOPY. An admin sets this per item (see
// ApplicationsService.setComplianceItemSubmissionType()) - it's not
// something an applicant chooses, since a hardcopy submission by definition
// never touches the system for them to declare.
enum ComplianceSubmissionType {
  SOFTCOPY
  HARDCOPY
  BOTH
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Optional display name for ADMIN/PANEL accounts (set via Users
  // Management) - shown instead of email wherever a panel member is
  // selected/listed (Positions, Interview Panel). Falls back to email when
  // null, so existing accounts created before this field don't regress.
  name         String?
  passwordHash String
  role         Role     @default(APPLICANT)
  // Set when a temporary password is issued via forgot-password; forces the
  // frontend to redirect straight to Change Password after login, and is
  // cleared automatically the moment any password change succeeds.
  mustChangePassword Boolean  @default(false)
  // Bumped on any password change or admin-initiated account update;
  // embedded in each access token at login and re-checked on every request
  // in authenticate(). A mismatch means the token was issued before the
  // account's role/password last changed, so it's rejected even though it
  // hasn't naturally expired yet - closes the stale-token revocation gap
  // (see docs/decisions.md).
  tokenVersion       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applicant             Applicant?
  jobPostingsMade       JobPosting[]
  siftingsMade          Application[]
  auditLogEntries       AuditLog[]
  panelAssignments      PanelAssignment[]
  panelEvaluations      PanelEvaluation[]
  positionPanelMemberOf PositionPanelMember[]
  complianceReviewsMade ApplicationComplianceItem[]

  @@map("users")
}

/// Demographic profile + reusable applicant record. Created once per user;
/// referenced by every Application the user submits.
model Applicant {
  id     String @id @default(uuid())
  userId String @unique

  firstName     String
  middleName    String?
  lastName      String
  suffix        String?
  dateOfBirth   DateTime
  sex           String
  civilStatus   String
  address       String
  contactNumber String

  // Eligibility (Y/N). If Y, eligibilityType records the checklist item
  // chosen (RA1080 / CSC Professional / CSC Sub-Professional / Barangay)
  // and proof must be uploaded as a Document(type=ELIGIBILITY_PROOF).
  // If N, eligibilityValidated stays false and the record is flagged for
  // manual admin validation (surfaced in the UI in red).
  hasEligibility       Boolean         @default(false)
  eligibilityType      EligibilityType @default(NONE)
  eligibilityValidated Boolean         @default(false)

  // Structured counterparts to JobPosting.minEducationLevel/
  // minYearsExperience, collected on the Demographic Profile step -
  // enables an automatic Sifting hint the same way eligibilityType already
  // does. yearsOfExperience is a single self-reported number rather than a
  // full list of entries: WorkExperience (below) exists in the schema but
  // is deliberately never collected from applicants (see the comment on
  // RegistrationPage.tsx) since that would duplicate what's already on the
  // required PDS upload - this is a lighter-weight structured number for
  // comparison purposes only, not a replacement for the PDS.
  educationLevel    EducationLevel
  yearsOfExperience Int            @default(0)

  // Set once the applicant finishes every step of the registration flow
  // (profile, work experience, L&D, awards, documents). Null means the
  // applicant is mid-registration; gates access to the rest of the app so
  // no applicant data collection is deferred to after login.
  registrationCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workExperiences WorkExperience[]
  ldInterventions LdIntervention[]
  awards          Award[]
  documents       Document[]
  applications    Application[]

  @@map("applicants")
}

model WorkExperience {
  id                  String    @id @default(uuid())
  applicantId         String
  inclusiveFrom       DateTime
  inclusiveTo         DateTime?
  positionDesignation String
  agency              String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("work_experiences")
}

model LdIntervention {
  id               String   @id @default(uuid())
  applicantId      String
  title            String
  dateAttended     DateTime
  numberOfHours    Int
  sponsoringAgency String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applicant Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([applicantId])
  @@map("ld_interventions")
}

model Award {
  id          String   @id @default(uuid())
  applicantId String
  title       String
  dateAwarded DateTime
  issuingBody String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicant Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([applicantId])
  @@map("awards")
}

/// Uploaded proof documents. Every applicant-level document type
/// (APPLICATION_LETTER, PDS, IPCR, ELIGIBILITY_PROOF, TRANSCRIPT_OF_RECORDS,
/// DIPLOMA, PQE_NOTICE, DESIGNATION_ORDER, OTHER) is uploaded against the
/// applicant during registration (applicationId null) - none of them are
/// gated to, or require, a specific Application. LD_PROOF and AWARD_PROOF
/// are the exceptions, each tied to the specific LdIntervention/Award entry
/// it backs up - required per entry (see ApplicantsService.completeRegistration()),
/// same as Eligibility Proof is required when hasEligibility is declared.
model Document {
  id               String       @id @default(uuid())
  applicantId      String
  applicationId    String?
  ldInterventionId String?
  awardId          String?
  complianceItemId String?
  type             DocumentType
  fileName         String
  filePath         String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime     @default(now())

  applicant      Applicant                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  application    Application?               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ldIntervention LdIntervention?            @relation(fields: [ldInterventionId], references: [id], onDelete: Cascade)
  award          Award?                     @relation(fields: [awardId], references: [id], onDelete: Cascade)
  complianceItem ApplicationComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([applicationId])
  @@index([ldInterventionId])
  @@index([awardId])
  @@index([complianceItemId])
  @@map("documents")
}

/// A vacancy applicants can apply to. closingAt is computed server-side at
/// creation time as postedAt + 10 days, 23:59:59 (see JobPostingsService).
model JobPosting {
  id                       String           @id @default(uuid())
  title                    String
  // Which recruitment publication round/batch this posting belongs to -
  // free text set by the admin (e.g. "ROS-1", "ROS-2"), not a fixed list.
  publication              String           @default("ROS-1")
  description              String           @db.Text
  numberOfVacantPositions  String
  plantillaNumbers         String           @db.Text
  // salaryGrade is constrained to "1".."33" at the DTO layer (a zod enum,
  // not a DB-level check - see job-postings.dto.ts), not free text like its
  // sibling fields. monthlySalary stays a String column (same "carry the
  // value formatted exactly as the document prints it" reasoning as the
  // rest of this model) but is no longer admin-typed - JobPostingsService
  // computes and overwrites it from salaryGrade via the official DBM Salary
  // Grade schedule (backend/src/shared/constants/salaryGrades.ts) on every
  // create/update, so the two can never disagree. See docs/decisions.md's
  // 2026-08-12 "Fixed Monthly Salary derived from Salary Grade" entry.
  salaryGrade              String
  monthlySalary            String
  placeOfAssignment        String           @db.Text
  positionNextInRank       String           @db.Text
  qualificationEducation   String           @db.Text
  qualificationTraining    String           @db.Text
  qualificationExperience  String           @db.Text
  qualificationEligibility String           @db.Text
  // Structured minimums in parallel with the free-text qualificationX
  // fields above - null means no automatic check for that criterion (e.g.
  // an admin who only filled in the free-text description). These never
  // replace the free text, which stays the authoritative QS wording; they
  // only drive an automatic "meets/below" hint on the Sifting screen,
  // computed client-side (frontend/src/shared/utils/qualificationMatch.ts)
  // from these fields plus the matching Applicant fields.
  minEducationLevel        EducationLevel?
  minYearsExperience       Int?
  minTrainingHours         Int?
  // Free text, one duty per line - rendered as a numbered list on the
  // applicant-facing details view.
  duties                   String           @db.Text
  postedAt                 DateTime         @default(now())
  closingAt                DateTime
  status                   JobPostingStatus @default(OPEN)
  // Nullable + SetNull (not the required/Restrict Prisma would otherwise
  // default to) so deleting the admin who posted a job doesn't get
  // blocked by, or cascade into deleting, the postings they made.
  createdByUserId          String?
  // Which master Position this posting was created from, if any - drives
  // the auto-assignment of that position's default panel members at
  // creation time (see JobPostingsService.create). Nullable + SetNull so
  // deleting a Position later doesn't touch postings already made from it;
  // postings created before this feature existed also have none.
  positionId               String?

  createdBy             User?                           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  position              Position?                       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  applications          Application[]
  panelAssignments      PanelAssignment[]
  requiredEligibilities JobPostingRequiredEligibility[]

  @@index([status])
  @@index([publication])
  @@index([positionId])
  @@map("job_postings")
}

/// Master list of reusable positions (e.g. "Administrative Officer II").
/// Selected from a dropdown when creating a job posting, instead of typing
/// a free-text title - and carries a pre-made group of Panel members that
/// get auto-assigned to the posting's interview board at creation time.
model Position {
  id        String   @id @default(uuid())
  title     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panelMembers PositionPanelMember[]
  jobPostings  JobPosting[]

  @@map("positions")
}

/// One PANEL user in a Position's default panel group. Always fully
/// replaced (delete + recreate) on save rather than diffed - same
/// convention as JobPostingRequiredEligibility under JobPosting.
model PositionPanelMember {
  id          String @id @default(uuid())
  positionId  String
  panelUserId String

  position  Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  panelUser User     @relation(fields: [panelUserId], references: [id], onDelete: Cascade)

  @@unique([positionId, panelUserId])
  @@map("position_panel_members")
}

/// One required eligibility type for a posting (e.g. a posting requiring
/// either RA1080 or CSC Professional has two rows). Empty for a posting -
/// no row at all - means no eligibility is required to apply. A join table
/// rather than a Prisma scalar list because MySQL doesn't support those.
model JobPostingRequiredEligibility {
  id              String          @id @default(uuid())
  jobPostingId    String
  eligibilityType EligibilityType

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, eligibilityType])
  @@map("job_posting_required_eligibilities")
}

/// One applicant's application to one job posting. Unique per
/// (applicantId, jobPostingId) - an applicant may apply to several
/// postings but only once each.
model Application {
  id           String            @id @default(uuid())
  applicantId  String
  jobPostingId String
  status       ApplicationStatus @default(SUBMITTED)
  submittedAt  DateTime          @default(now())

  // Set together by ApplicationsService.sift() (admin-only) - the Sifting
  // phase's pass/fail call against the posting's qualification standards
  // (education/training/experience/eligibility). See docs/rsp-domain-spec.md.
  siftingRemarks String?   @db.Text
  siftedAt       DateTime?
  siftedByUserId String?

  // Set by ApplicationsService.importExaminationScores() (admin-only) - the
  // Pre-Qualifying Examination is conducted outside the system; the score is
  // imported via an Excel upload matched to the applicant by name.
  examinationScore    Int?
  examinationScoredAt DateTime?

  // Set together by ApplicationsService.scheduleInterview() (admin-only).
  // interviewVenue is required once scheduled (a date with no place isn't
  // useful); attire/notes are optional free text for anything else the
  // applicant needs to know ("what to wear", parking, documents to bring).
  // interviewScheduledEndAt is optional - per docs/rsp-domain-spec.md, the
  // Evaluation of Applicants phase is scheduled for up to 2 days (shortlisting
  // after day 1 only if applicants exceed the 1:5 ratio), so a single day is
  // still valid and this stays null in that case.
  interviewScheduledAt    DateTime?
  interviewScheduledEndAt DateTime?
  interviewVenue          String?   @db.Text
  interviewAttire         String?   @db.Text
  interviewNotes          String?   @db.Text

  // Set by ApplicationsService.withdraw() - applicant-initiated, on their own
  // application only (no admin equivalent, so unlike siftedByUserId there's
  // no separate actor column: applicantId already identifies who withdrew).
  withdrawnAt DateTime?

  // Set by ApplicationsService.moveToCompliance() (admin-only) - the RD's
  // decision to advance this applicant past Evaluation. Creates one
  // ApplicationComplianceItem per currently-active ComplianceRequirement
  // (a snapshot, not a live join - see docs/decisions.md).
  complianceRequestedAt DateTime?
  // Set by ApplicationsService.scheduleOathTaking() once every compliance
  // item is VERIFIED - bundles the status change and the oath-taking
  // schedule into one action, the same shape as scheduleInterview().
  complianceCompletedAt DateTime?
  oathTakingScheduledAt DateTime?
  oathTakingVenue       String?   @db.Text
  oathTakingNotes       String?   @db.Text
  // Set by ApplicationsService.markHired() - terminal for this pipeline
  // segment. Onboarding itself (videos, pre/post evaluations) is future work.
  hiredAt               DateTime?

  // Set together by ApplicationsService.rejectAfterInterview() (FOR_INTERVIEW
  // -> NOT_SELECTED) or rejectAfterCompliance() (FOR_COMPLIANCE ->
  // DISQUALIFIED) - one shared pair of columns rather than two near-identical
  // sets, since both are the same kind of one-shot terminal "regret" call an
  // admin makes, just from a different stage. remarks is optional free text
  // included in the regret email sent to the applicant.
  rejectedAt       DateTime?
  rejectionRemarks String?   @db.Text

  // Set automatically (never by direct admin/panelist action) when this
  // application's panel interview score is carried over from another of
  // the same applicant's applications rather than scored here - see
  // ApplicationsRepository.createWithApplicationLetter() (new applications)
  // and PanelEvaluationsRepository.linkSiblingScoreSources() (propagated
  // the moment the source application is actually scored). Always points
  // directly at a canonical (non-inheriting) application, never chained
  // through another inheriting one. Null means this application either has
  // its own PanelEvaluation rows, or hasn't been scored/linked yet.
  scoreSourceApplicationId String?

  applicant        Applicant                   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobPosting       JobPosting                  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  siftedBy         User?                       @relation(fields: [siftedByUserId], references: [id])
  documents        Document[]
  panelEvaluations PanelEvaluation[]
  complianceItems  ApplicationComplianceItem[]
  groupMemberships ApplicantGroupMember[]

  scoreSourceApplication      Application?  @relation("ApplicationScoreInheritance", fields: [scoreSourceApplicationId], references: [id])
  scoreInheritingApplications Application[] @relation("ApplicationScoreInheritance")

  @@unique([applicantId, jobPostingId])
  @@index([jobPostingId])
  @@index([scoreSourceApplicationId])
  @@map("applications")
}

/// Admin-managed interview rubric (spec: "Administrator can edit/update
/// evaluation forms"), top-level grouping - e.g. "Communication Skills" set
/// to weightPercent: 25, meaning this category is worth exactly 25% of the
/// overall evaluation no matter how many criteria it has or what they sum
/// to. weightPercent is the admin-set, authoritative share; it is NOT
/// derived from the category's criteria the way its raw point total is.
/// Carries no *raw* maxScore of its own: that number (the scale a panelist
/// actually fills in scores against, criterion by criterion) is the sum of
/// its active Criterion rows' maxScore, computed at read time
/// (CategoriesRepository) rather than stored, so it can't drift out of sync
/// with its own children. A panelist's raw subtotal for this category is
/// normalized against that raw total and then scaled to weightPercent
/// before it counts toward the overall score - see
/// PanelEvaluationsService's weighted-scoring helpers - so a category with
/// many high-point criteria contributes exactly as much as one with a
/// single low-point criterion, provided both carry the same weightPercent.
/// isActive lets a category be retired without breaking historical
/// PanelScore rows still attached to its criteria.
model Category {
  id            String   @id @default(uuid())
  name          String
  weightPercent Int
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  criteria Criterion[]

  @@map("categories")
}

/// One individually-scored rubric line within a Category (e.g. "Clarity of
/// response" under "Communication Skills") - each panelist gives this one
/// its own 0-maxScore mark (PanelScore), not the category as a whole. Unlike
/// the old free-replace EvaluationCriterionQuestion this replaced, a
/// Criterion can carry real historical PanelScore rows, so
/// CategoriesService.update() diffs the incoming criteria list against
/// what's on file instead of blindly deleting and recreating it - removing
/// one that already has scores is blocked (409) the same way deleting a
/// whole Category is, directing the admin to set isActive: false instead.
model Criterion {
  id         String   @id @default(uuid())
  categoryId String
  name       String   @db.Text
  maxScore   Int
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scores   PanelScore[]

  @@index([categoryId])
  @@map("criteria")
}

/// Which PANEL users sit on which job posting's interview board. Pure
/// assignment metadata - deleting the posting or the panel user just drops
/// the assignment, not blocked (unlike the audit-relevant rows below).
model PanelAssignment {
  id           String   @id @default(uuid())
  jobPostingId String
  panelUserId  String
  assignedAt   DateTime @default(now())

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  panelUser  User       @relation(fields: [panelUserId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, panelUserId])
  @@map("panel_assignments")
}

/// One panelist's evaluation of one application - header row (remarks +
/// timestamps); per-criterion scores live in PanelScore. Upserted by
/// PanelEvaluationsService.submit() the same way ApplicationsService.evaluate()
/// overwrites a prior single-admin evaluation.
model PanelEvaluation {
  id            String   @id @default(uuid())
  applicationId String
  panelUserId   String
  remarks       String?  @db.Text
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  panelUser   User         @relation(fields: [panelUserId], references: [id], onDelete: Cascade)
  scores      PanelScore[]

  @@unique([applicationId, panelUserId])
  @@map("panel_evaluations")
}

/// One Criterion's score within a PanelEvaluation - the fine-grained unit
/// scoring happens at (a Category is never scored directly, only reported
/// as the sum of its criteria). criterionId has no onDelete override
/// (defaults to Restrict) - CategoriesService blocks removing a criterion
/// that already has scores, directing the admin to deactivate it instead
/// (see Criterion.isActive).
model PanelScore {
  id                String @id @default(uuid())
  panelEvaluationId String
  criterionId       String
  score             Int

  panelEvaluation PanelEvaluation @relation(fields: [panelEvaluationId], references: [id], onDelete: Cascade)
  criterion       Criterion       @relation(fields: [criterionId], references: [id])

  @@unique([panelEvaluationId, criterionId])
  @@map("panel_scores")
}

/// Admin-defined ad hoc grouping of applicants for Group Dynamics Evaluation -
/// a distinct, non-scored assessment activity, separate from the individual
/// interview rubric (Category/Criterion/PanelScore above). Just a name,
/// optional description, and a member list; carries no jobPostingId of its
/// own since a single group exercise can mix applicants from different
/// postings (unlike PanelAssignment, which is keyed to one posting's board).
model ApplicantGroup {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ApplicantGroupMember[]

  @@map("applicant_groups")
}

/// Membership join: which Application belongs to which ApplicantGroup.
/// Keyed to the Application (a specific candidacy for one posting), not the
/// Applicant directly - the same scoping PanelEvaluation uses - so grouping
/// an applicant for one posting's Group Dynamics Evaluation doesn't imply
/// anything about their other applications.
model ApplicantGroupMember {
  id            String   @id @default(uuid())
  groupId       String
  applicationId String
  createdAt     DateTime @default(now())

  group       ApplicantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([groupId, applicationId])
  @@index([applicationId])
  @@map("applicant_group_members")
}

/// Admin-managed catalog of CSC-mandated documentary requirements for the
/// Compliance to Requirements phase (docs/rsp-domain-spec.md §6). Global,
/// not per-posting - same simplification already accepted for Category
/// (see docs/project-memory.md Known Limitations). isActive retires a
/// requirement without breaking historical ApplicationComplianceItem rows,
/// same convention as Category.
model ComplianceRequirement {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ApplicationComplianceItem[]

  @@map("compliance_requirements")
}

/// One requirement's checklist row for one application - usually a
/// snapshot taken of the then-active ComplianceRequirement list at
/// ApplicationsService.moveToCompliance() time (not a live join, see
/// docs/decisions.md), but an admin can also attach one more requirement to
/// a single application via ApplicationsService.addComplianceItem() when
/// that snapshot came up short. Verifying an item requires both the
/// applicant's submission and an admin's approval of it - what counts as
/// "the submission" depends on submissionType: a SOFTCOPY item needs an
/// uploaded Document(type=COMPLIANCE_PROOF, complianceItemId=this row's id)
/// before VERIFIED is allowed, while a HARDCOPY item has no online
/// counterpart to require - the admin's VERIFIED is itself the record that
/// the physical copy was received and approved (see
/// ApplicationsService.reviewComplianceItem()). requirementId has no
/// onDelete override (defaults to Restrict) - same convention as
/// PanelScore.criterionId - ComplianceRequirementsService blocks deleting a
/// requirement that already has items, directing the admin to deactivate it
/// instead.
model ApplicationComplianceItem {
  id               String                   @id @default(uuid())
  applicationId    String
  requirementId    String
  status           ComplianceItemStatus     @default(PENDING)
  submissionType   ComplianceSubmissionType @default(SOFTCOPY)
  remarks          String?                  @db.Text
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime                 @default(now())

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id])
  reviewedBy  User?                 @relation(fields: [reviewedByUserId], references: [id])
  documents   Document[]

  @@unique([applicationId, requirementId])
  @@index([requirementId])
  @@map("application_compliance_items")
}

/// Append-only record of admin write actions (user/job-posting CRUD,
/// application evaluation). Deliberately has no update/delete path through
/// the API - see docs/decisions.md for why an audit trail must stay
/// write-once from the app's perspective.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
