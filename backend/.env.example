NODE_ENV=development
PORT=4000

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/dilgr8rsp"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:5173"

# Local file upload storage directory (relative to backend/)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# Optional. Applicant stage-change emails (application received, scheduled for
# interview, qualified/not qualified) are logged to the console prefixed
# "[DEV EMAIL]" instead of sent when SMTP_HOST is unset - no mail server is
# required for local development.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="change-me"
# SMTP_SECURE=false
# SMTP_FROM="DILGR8RSP <no-reply@dilg.gov.ph>"

# Optional. Gates the historical-hiring-data module (a private hire-likelihood
# training dataset, not part of the visible admin panel) to exactly this one
# account's email - unset means the routes 403 everyone, including ADMINs.
# HISTORICAL_DATA_OWNER_EMAIL="your-own-account@example.com"
